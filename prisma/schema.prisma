generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadSearchStatus {
  PENDING
  RUNNING
  DONE
  DONE_NO_RESULTS
  FAILED
}

enum LeadSearchRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum LeadProvider {
  SCRAPER_CITY
  SEARCH_LEADS
  BOOMERANG
  DADDY_LEADS
  APIFY
  SCRUPP
}

enum LeadOrigin {
  PROVIDER
  MANUAL
  CSV_IMPORT
}

enum EmailStatus {
  DELIVERABLE
  UNDELIVERABLE
  RISKY
  CATCH_ALL
  UNKNOWN
  VALID
  INVALID
}

enum LeadListStatus {
  NEW
  CONTACTED
  REPLIED
}

enum UserRole {
  ADMIN
  SALE_MANAGER
  COMPANY
}

enum LeadSearchKind {
  LEAD_DB
  SCRAPER
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageType {
  TEXT
  JSON
  EVENT
  OUTREACH
}

enum CompanyResearchItemCategory {
  NEWS
  BLOG
  ACTIVITY
  WEBSITE
  LINKEDIN_POST
}

enum CompanyResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CompanySize {
  SELF_EMPLOYED
  STARTUP_1_10
  SMALL_11_50
  MEDIUM_51_200
  LARGE_201_500
  ENTERPRISE_501_1000
  CORPORATE_1001_5000
  MEGA_5001_10000
  GIANT_10000_PLUS
  UNKNOWN
}

enum SeniorityLevel {
  INTERN
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  SENIOR_MANAGER
  DIRECTOR
  SENIOR_DIRECTOR
  VP
  SVP
  C_LEVEL
  FOUNDER
  OWNER
  UNKNOWN
}

enum LeadEnrichmentStatus {
  PENDING
  PROCESSING
  AWAITING_REVIEW
  COMPLETED
  FAILED
}

enum EnrichmentFieldStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
}

enum OutreachStage {
  UNSPECIFIED
  CONNECTION_REQUEST
  POST_ACCEPT_FIRST_MESSAGE
  LINKEDIN_FOLLOW_UP_1
  LINKEDIN_FOLLOW_UP_2
  LINKEDIN_CLOSE_LOOP
  COLD_EMAIL
  WARM_EMAIL
  INTRODUCTION_EMAIL
  EMAIL_FOLLOW_UP_1
  EMAIL_FOLLOW_UP_2
  EMAIL_CLOSE_LOOP
  FOLLOW_UP_NO_REPLY
  AFTER_POSITIVE_REPLY
  REPLY_TO_QUESTION
}

enum MessageSender {
  SALE_MANAGER
  LEAD
}

enum PipelineRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PipelineStepRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
}

enum MonitoredSourceChannel {
  REDDIT
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String    @unique
  passwordHash String
  role         UserRole  @default(SALE_MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Company-specific fields
  companyName String?

  // Custom AI instructions for outreach personalization
  customInstructions String? @db.VarChar(500)

  // Balance (stored in cents to avoid floating-point issues; display as dollars)
  // WARNING: never update balanceCents directly — use BalanceCommandService.adjustBalance() only
  balanceCents Int @default(0)

  balanceAuditLogs BalanceAuditLog[]

  // Company association (self-referencing)
  companyId String?
  company   User?   @relation("CompanyMembers", fields: [companyId], references: [id])
  members   User[]  @relation("CompanyMembers")

  leadSearchesCreated     LeadSearch[]    @relation("LeadSearchCreatedBy")
  leadSearchRunsTriggered LeadSearchRun[] @relation("LeadSearchRunTriggeredBy")

  leadsCreated      Lead[]            @relation("LeadCreatedBy")
  leadSearchLeads   LeadSearchLead[]
  chatThreads       ChatThread[]      @relation("ChatThreadOwner")
  chatMessages      ChatMessage[]     @relation("ChatMessageAuthor")
  leadDirectories   LeadDirectory[]
  companyResearches CompanyResearch[] @relation("CompanyResearchRequestedBy")

  enrichmentRequestsCreated LeadEnrichmentRequest[]     @relation("EnrichmentRequestedBy")
  enrichmentFieldsReviewed  LeadEnrichmentFieldChange[] @relation("EnrichmentFieldReviewedBy")

  conversationMessagesCreated LeadConversationMessage[] @relation("ConversationMessageCreator")

  serviceCatalogs CompanyServiceCatalog[] @relation("CompanyServiceCatalogs")

  pipelineRuns PipelineRun[] @relation("PipelineRunCreatedBy")

  serviceTogglesUpdated  ServiceToggle[]  @relation("ServiceToggleUpdatedBy")
  monitoredSourcesUpdated MonitoredSource[] @relation("MonitoredSourceUpdatedBy")

  icpConfig CompanyIcpConfig? @relation("CompanyIcpConfig")

  @@unique([companyName])
  @@index([role])
  @@index([isActive])
  @@index([companyId])
}

// Audit trail for every balance change. Immutable — rows are never updated or deleted.
model BalanceAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Signed delta in cents: positive = credit, negative = debit
  amountCents   Int
  balanceBefore Int
  balanceAfter  Int

  // Human-readable reason for the change (e.g. "Manual top-up by admin")
  reason String @db.VarChar(500)

  // ID of the user (admin) who performed the operation
  performedBy String

  @@index([userId])
  @@index([createdAt])
}

model LeadSearch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation("LeadSearchCreatedBy", fields: [createdById], references: [id])

  provider LeadProvider
  kind     LeadSearchKind

  capability LeadProviderCapability @relation(fields: [provider, kind], references: [provider, kind])

  threadId String?
  thread   ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  prompt String?
  query  Json
  limit  Int

  status       LeadSearchStatus @default(PENDING)
  totalLeads   Int?
  errorMessage String?

  runs         LeadSearchRun[]
  leads        LeadSearchLead[]
  chatMessages ChatMessage[]

  @@index([createdById])
  @@index([status])
  @@index([threadId])
  @@index([provider, kind])
}

model LeadSearchRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadSearchId String
  leadSearch   LeadSearch @relation(fields: [leadSearchId], references: [id], onDelete: Cascade)

  provider LeadProvider
  attempt  Int          @default(1)

  triggeredById String?
  triggeredBy   User?   @relation("LeadSearchRunTriggeredBy", fields: [triggeredById], references: [id])

  status       LeadSearchRunStatus @default(RUNNING)
  errorMessage String?

  leadsCount    Int?
  externalRunId String?

  requestPayload Json?
  responseMeta   Json?

  results LeadSearchRunResult[]

  @@unique([leadSearchId, provider, attempt])
  @@index([leadSearchId])
  @@index([provider, status])
  @@index([triggeredById])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origin               LeadOrigin @default(PROVIDER)
  isVerified           Boolean    @default(false)
  hasPendingEnrichment Boolean    @default(false)

  createdById String?
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  // Basic Info
  fullName     String?
  firstName    String?
  lastName     String?
  title        String?
  headline     String?
  linkedinUrl  String?
  location     String?
  email        String?
  emailStatus  EmailStatus?
  mobileNumber String?

  // Company Info
  company            String?
  companyDomain      String?
  companyUrl         String?
  companyId          String?
  companyLinkedinUrl String?
  companyPhone       String?
  companySize        CompanySize?
  companyIndustry    String?
  companyLocation    String?

  // Position & Career
  currentPosition      String?
  seniorityLevel       SeniorityLevel?
  department           String?
  yearsInPosition      Int?
  yearsInCompany       Int?
  totalExperienceYears Int?

  meta Json?

  providerRefs       LeadProviderRef[]
  searches           LeadSearchLead[]
  runResults         LeadSearchRunResult[]
  leadDirectoryLeads LeadDirectoryLead[]
  companyWebsites    LeadCompanyWebsite[]
  emails             LeadEmail[]
  companyResearches  CompanyResearch[]

  enrichmentRequests LeadEnrichmentRequest[]

  conversationMessages LeadConversationMessage[] @relation("ConversationLead")
  chatMessages         ChatMessage[]
  scores               LeadScore[]
  pipelineRunLeads     PipelineRunLead[]
  hiringSignals        HiringSignal[]
  redditSignals        RedditSignal[]
  crunchbaseSignals    CrunchbaseSignal[]

  @@unique([email])
  @@unique([linkedinUrl])
  @@index([email])
  @@index([linkedinUrl])
  @@index([companyDomain])
  @@index([companyId])
  @@index([isVerified])
  @@index([hasPendingEnrichment])
  @@index([emailStatus])
  @@index([seniorityLevel])
  @@index([companySize])
}

model LeadProviderRef {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider   LeadProvider
  externalId String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([leadId])
}

model LeadSearchLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadSearchId String
  leadSearch   LeadSearch @relation(fields: [leadSearchId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status LeadListStatus @default(NEW)
  notes  String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  @@unique([leadSearchId, leadId])
  @@index([leadSearchId, status])
  @@index([assignedToId])
}

model LeadSearchRunResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  runId String
  run   LeadSearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  provider           LeadProvider
  providerExternalId String?

  raw                Json?
  rawBucket          String?
  rawObjectKey       String?
  rawContentType     String?
  rawContentEncoding String?
  rawSizeBytes       Int?
  rawEtag            String?

  @@unique([runId, leadId])
  @@index([runId])
  @@index([leadId])
  @@index([provider, providerExternalId])
}

model LeadProviderCapability {
  provider LeadProvider
  kind     LeadSearchKind

  label        String?
  description  String?
  leadSearches LeadSearch[]

  @@id([provider, kind])
}

model ChatThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("ChatThreadOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title String?

  defaultProvider LeadProvider?
  defaultKind     LeadSearchKind?

  lastMessageAt DateTime?
  meta          Json?

  messages     ChatMessage[]
  leadSearches LeadSearch[]

  @@index([ownerId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role ChatMessageRole
  type ChatMessageType @default(TEXT)

  authorUserId String?
  authorUser   User?   @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  text    String?
  payload Json?

  leadSearchId String?
  leadSearch   LeadSearch? @relation(fields: [leadSearchId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  leadConversationMessages LeadConversationMessage[]

  @@index([threadId, createdAt])
  @@index([authorUserId])
  @@index([leadSearchId])
  @@index([leadId])
}

model LeadDirectory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId String?
  parent   LeadDirectory?  @relation("LeadDirectoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children LeadDirectory[] @relation("LeadDirectoryTree")

  name        String  @db.Citext
  description String?
  position    Int     @default(0)

  leads LeadDirectoryLead[]

  @@unique([ownerId, name])
  @@index([ownerId, parentId])
  @@index([ownerId, updatedAt])
  @@index([parentId, position])
}

model LeadDirectoryLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  directoryId String
  directory   LeadDirectory @relation(fields: [directoryId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([directoryId, leadId])
  @@index([directoryId, createdAt])
  @@index([leadId])
}

model LeadCompanyWebsite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  url              String
  domain           String
  validEmailServer Boolean?

  @@unique([leadId, domain])
  @@index([leadId])
  @@index([domain])
}

model LeadEmail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  email            String
  deliverable      Boolean?
  catchAllDomain   Boolean?
  validEmailServer Boolean?
  free             Boolean?
  status           EmailStatus?
  qualityScore     Int?

  isPrimary Boolean @default(false)

  @@unique([leadId, email])
  @@index([leadId])
  @@index([email])
  @@index([status])
  @@index([isPrimary])
}

model CompanyResearch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("CompanyResearchRequestedBy", fields: [requestedById], references: [id])

  company       String
  companyDomain String?

  recency    String? // day, week, month, year
  maxResults Int     @default(5)

  status       CompanyResearchStatus @default(PENDING)
  errorMessage String?

  searchedAt DateTime @default(now())

  items            CompanyResearchItem[]
  relatedQuestions String[]

  @@index([leadId, createdAt])
  @@index([requestedById])
  @@index([company])
  @@index([status])
}

model CompanyResearchItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  researchId String
  research   CompanyResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  date      String? // ISO date string or null if unknown
  summary   String                      @db.Text
  sourceUrl String
  category  CompanyResearchItemCategory
  source    String? // 'perplexity' | 'linkedin'

  @@index([researchId])
  @@index([category])
}

model LeadEnrichmentRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("EnrichmentRequestedBy", fields: [requestedById], references: [id])

  status LeadEnrichmentStatus @default(PENDING)

  apifyRunId     String?
  apifyDatasetId String?

  rawResponse  Json?
  errorMessage String?

  fieldChanges LeadEnrichmentFieldChange[]

  @@index([leadId, status])
  @@index([requestedById])
  @@index([status, createdAt])
}

model LeadEnrichmentFieldChange {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestId String
  request   LeadEnrichmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fieldName   String
  displayName String

  oldValue String?
  newValue String?

  status EnrichmentFieldStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("EnrichmentFieldReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([requestId, fieldName])
  @@index([requestId])
  @@index([status])
}

model LeadConversationMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation("ConversationLead", fields: [leadId], references: [id], onDelete: Cascade)

  createdBy String?
  creator   User?   @relation("ConversationMessageCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  senderType MessageSender // SALE_MANAGER or LEAD

  channel OutreachChannel // EMAIL or LINKEDIN
  stage   OutreachStage?

  subject String? // For email messages
  body    String  @db.Text

  // Metadata from AI generation (if applicable)
  characterCount Int?
  wordCount      Int?
  usageNote      String? @db.Text
  tacticUsed     String?

  // Tracking
  sentAt    DateTime?
  repliedAt DateTime?

  // Reference to original outreach message if came from chat
  chatMessageId String?
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  pipelineOutreachLinks PipelineRunOutreachMessage[]

  @@index([leadId, createdAt])
  @@index([createdBy])
  @@index([channel])
  @@index([stage])
  @@index([sentAt])
  @@index([chatMessageId])
}

model CompanyServiceCatalog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   User   @relation("CompanyServiceCatalogs", fields: [companyId], references: [id])

  name String @db.Citext

  subServices      CompanyServiceCatalogSubService[]
  signalCategories SignalCategoryConfig[]

  @@unique([companyId, name])
  @@index([companyId])
}

model CompanyServiceCatalogSubService {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyServiceCatalogId String
  companyServiceCatalog   CompanyServiceCatalog @relation(fields: [companyServiceCatalogId], references: [id], onDelete: Cascade)

  name      String @db.Citext
  priority  Int
  budgetMin Int
  budgetMax Int

  @@unique([companyServiceCatalogId, name])
  @@index([companyServiceCatalogId])
}

model PipelineRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelineKey     String
  pipelineVersion Int    @default(1)

  createdById String
  createdBy   User   @relation("PipelineRunCreatedBy", fields: [createdById], references: [id])

  companyId String?

  status           PipelineRunStatus @default(PENDING)
  currentStepId    String?
  currentStepIndex Int?

  pipelineDisplayName     String
  pipelineDescription     String?
  defaultOnError          String?
  defaultTimeoutMs        Int?
  defaultRetryMaxAttempts Int?
  defaultRetryBackoffMs   Int?
  defaultRetryBackoffType String?
  inputDirectoryId        String?
  inputLeadIds            String[]

  startedAt  DateTime?
  finishedAt DateTime?

  errorMessage String?
  errorStepId  String?

  stepRuns              PipelineStepRun[]
  pipelineRunLeads      PipelineRunLead[]
  pipelineOutreachLinks PipelineRunOutreachMessage[]

  @@index([createdById])
  @@index([companyId, status])
  @@index([status])
  @@index([pipelineKey])
}

model PipelineStepRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  stepId      String
  stepType    String
  stepIndex   Int
  displayName String

  status PipelineStepRunStatus @default(QUEUED)

  stepConfig       Json?
  onError          String?
  timeoutMs        Int?
  retryMaxAttempts Int?
  retryBackoffMs   Int?
  retryBackoffType String?
  enabled          Boolean @default(true)

  attempts Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  outputSummary Json?
  errorMessage  String?

  @@unique([pipelineRunId, stepId])
  @@index([pipelineRunId, stepIndex])
  @@index([status])
}

// ── Pipeline Run ↔ Lead link ─────────────────────────────────────────

model PipelineRunLead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  excluded         Boolean @default(false)
  excludedByStepId String?

  @@unique([pipelineRunId, leadId])
  @@index([pipelineRunId])
  @@index([pipelineRunId, excluded])
}

// ── Lead Scoring ─────────────────────────────────────────────────────

model LeadScore {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pipelineRunId  String?
  stepInstanceId String? // e.g. "scoring-initial", "scoring-final"

  score     Int     // 0-100: ICP fit score from AI
  reasoning String? // Brief AI justification

  // Final scoring components (populated by scoring-final step)
  icpFit         Int? // 0-100: ICP fit component from AI
  signalStrength Int? // 0-100: signal strength component
  finalScore     Int? // 0-100: weighted composite score

  @@index([leadId])
  @@index([pipelineRunId])
  @@index([pipelineRunId, stepInstanceId])
}

// ── Pipeline Run ↔ Outreach Message link ─────────────────────────────

model PipelineRunOutreachMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  messageId String
  message   LeadConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([pipelineRunId, messageId])
  @@index([pipelineRunId])
  @@index([messageId])
}

// ── Hiring Signals ────────────────────────────────────────────────────

/// Stores hiring signal detection results per lead per pipeline run.
/// Multiple leads at the same company share identical signal data (deduped at write time).
model HiringSignal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pipelineRunId String

  /// Which signal provider produced this (e.g. "hirebase")
  providerKey String

  /// Company name that was queried
  companyName String

  /// Total number of open job listings found (API total_count; may exceed returned jobs due to pagination)
  openJobCount Int

  /// Deduplicated job categories / departments actively hiring (denormalized summary)
  departments String[]

  /// Sample of job titles found (up to 10, denormalized summary)
  topJobTitles String[]

  /// Normalised job listings returned by the provider
  jobs HiringSignalJob[]

  @@unique([pipelineRunId, leadId, providerKey])
  @@index([leadId])
  @@index([pipelineRunId])
}

/// Individual job listing returned by a hiring-signal provider.
model HiringSignalJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  hiringSignalId String
  hiringSignal   HiringSignal @relation(fields: [hiringSignalId], references: [id], onDelete: Cascade)

  /// External ID from the provider (e.g. Hirebase _id)
  externalId String?

  jobTitle            String?
  team                String?
  jobType             String? /// e.g. "Full Time", "Part Time", "Contract"
  locationType        String? /// e.g. "In-Person", "Remote", "Hybrid"
  datePosted          String? /// ISO date string
  companyName         String?
  companySlug         String?
  requirementsSummary String? @db.Text

  skills        String[]
  technologies  String[]
  jobCategories String[]

  locations HiringSignalJobLocation[]

  @@index([hiringSignalId])
}

/// Location associated with a hiring signal job listing.
model HiringSignalJobLocation {
  id String @id @default(cuid())

  jobId String
  job   HiringSignalJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  city    String?
  region  String?
  country String?

  @@index([jobId])
}

/// Admin-managed runtime toggles for external service providers.
/// Display names are UI-safe and never reveal the actual vendor.
model ServiceToggle {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Internal key, never exposed to UI (e.g. "hirebase")
  serviceKey  String   @unique

  /// UI-facing name (e.g. "Hiring Intelligence")
  displayName String

  /// Optional description shown in admin UI
  description String?

  /// Grouping category for UI (e.g. "intelligence", "social")
  category    String

  /// Whether the service is enabled at runtime
  enabled     Boolean  @default(true)

  /// Who last toggled this service
  updatedById String?
  updatedBy   User?    @relation("ServiceToggleUpdatedBy", fields: [updatedById], references: [id])

  @@index([serviceKey])
}

/// Tracks daily API request counts per signal provider for soft rate limiting.
/// Keyed by provider + UTC date string ("YYYY-MM-DD") so counters reset at midnight UTC.
model SignalProviderDailyUsage {
  id           String @id @default(cuid())
  providerKey  String

  /// UTC date string, e.g. "2026-02-24"
  date         String

  requestCount Int @default(0)

  @@unique([providerKey, date])
  @@index([providerKey, date])
}

/// Admin-managed list of monitored sources across social channels.
/// Each row represents a single target (e.g. a subreddit, a Twitter handle)
/// that signal providers scan when looking for company mentions.
model MonitoredSource {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Which platform/channel this source belongs to
  channel     MonitoredSourceChannel

  /// Identifier within the channel (e.g. subreddit name "web3", handle "company")
  value       String

  /// Optional human-readable description for admin UI
  description String?

  /// Whether this source is active for monitoring
  enabled     Boolean  @default(true)

  /// Who last updated this source
  updatedById String?
  updatedBy   User?    @relation("MonitoredSourceUpdatedBy", fields: [updatedById], references: [id])

  @@unique([channel, value])
  @@index([channel, enabled])
}

/// Stores Reddit signal detection results per lead per pipeline run.
/// Multiple leads at the same company share identical signal data (deduped at write time).
model RedditSignal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pipelineRunId String

  /// Which signal provider produced this (e.g. "reddit-apify")
  providerKey   String

  /// Company name that was queried
  companyName   String

  /// Total posts/comments mentioning the company
  totalMentions   Int

  /// Total posts/comments by the company account (reserved for future profile scraping)
  totalActivities Int

  /// Subreddits where matches were found (denormalized summary)
  subredditsFound String[]

  /// Individual Reddit posts/comments found
  posts RedditSignalPost[]

  @@unique([pipelineRunId, leadId, providerKey])
  @@index([leadId])
  @@index([pipelineRunId])
}

/// Individual Reddit post or comment found by a Reddit signal provider.
model RedditSignalPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  redditSignalId String
  redditSignal   RedditSignal @relation(fields: [redditSignalId], references: [id], onDelete: Cascade)

  /// Subreddit name where this was found (without "r/" prefix)
  subreddit    String

  /// "post" or "comment"
  postType     String

  /// "mention" (found via keyword search) or "activity" (company's own post)
  signalType   String

  title        String?
  content      String?  @db.Text
  author       String?
  url          String?

  /// Reddit score (upvotes - downvotes)
  score        Int?

  /// Number of comments on this post
  numComments  Int?

  /// UTC date string when the post was created, e.g. "2026-01-15"
  createdUtc   String?

  @@index([redditSignalId])
}

// ── Crunchbase Signals ────────────────────────────────────────────────

/// Stores Crunchbase company data per lead per pipeline run.
/// Multiple leads at the same company share identical signal data (deduped at write time).
model CrunchbaseSignal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  leadId        String
  lead          Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pipelineRunId String

  /// Which signal provider produced this (e.g. "crunchbase-apify")
  providerKey   String

  /// Company name that was queried
  companyName   String

  /// Whether the company was found on Crunchbase
  crunchbaseFound Boolean @default(false)

  /// Crunchbase canonical slug (e.g. "gigradar-io")
  crunchbasePermalink String?

  // ── Funding ─────────────────────────────────────────────────────

  /// Total funding raised in USD
  fundingTotalUsd Float?

  /// Date of the most recent funding round (ISO date string)
  lastFundingAt   String?

  /// Type of the most recent funding round (e.g. "seed", "series_a")
  lastFundingType String?

  /// Total number of funding rounds
  numFundingRounds Int?

  // ── Growth & Heat ───────────────────────────────────────────────

  /// Crunchbase growth score (0-100)
  growthScore Int?

  /// Crunchbase heat score (0-100)
  heatScore   Int?

  /// Funding prediction probability (0-1). Real API field: funding_prediction.
  fundingPrediction Float?

  /// Funding prediction: probability for 0-5 months window
  fundingPrediction0to5  Float?
  /// Funding prediction: probability for 6-11 months window
  fundingPrediction6to11 Float?
  /// Funding prediction: probability for 12-24 months window
  fundingPrediction12to24 Float?
  /// Funding prediction: probability for 24+ months window
  fundingPrediction24plus Float?

  // ── Company Info ────────────────────────────────────────────────

  /// Crunchbase employee count enum (e.g. "c_00001_00010", "c_00051_00100")
  employeeCountEnum String?

  /// Latest monthly website visits from Semrush via Crunchbase
  semrushVisits     Int?

  /// Short company description from Crunchbase
  shortDescription  String? @db.Text

  /// Company founding date (ISO date string)
  foundedOn         String?

  /// Operating status (e.g. "active", "closed")
  operatingStatus   String?

  // ── Categories & Industry ──────────────────────────────────────

  /// Crunchbase industry categories (e.g. "Blockchain,Software,Mobile Apps")
  categories        String? @db.Text

  // ── Investors ──────────────────────────────────────────────────

  /// Number of investors
  numInvestors      Int?

  // ── Competitors ────────────────────────────────────────────────

  /// Top competitor names, comma-separated (up to 5)
  topCompetitors    String? @db.Text

  // ── Layoffs ────────────────────────────────────────────────────

  /// Whether the company has had layoffs according to Crunchbase
  hadLayoffs        Boolean @default(false)

  // ── Tech Stack ─────────────────────────────────────────────────

  /// Technologies used, comma-separated (from BuiltWith via Crunchbase)
  techStack         String? @db.Text

  // ── Predictions ────────────────────────────────────────────────

  /// IPO prediction probability (0-1)
  ipoPrediction        Float?

  /// Acquisition prediction probability (0-1)
  acquisitionPrediction Float?

  @@unique([pipelineRunId, leadId, providerKey])
  @@index([leadId])
  @@index([pipelineRunId])
}

// ────────────────────────────────────────────────────────────────────
// ICP (Ideal Customer Profile) Configuration
// ────────────────────────────────────────────────────────────────────

/// Company-level Ideal Customer Profile settings.
/// Stores location targets, company size filters, and links to industry selections.
/// One-to-one with the company User (companyId is unique).
model CompanyIcpConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String @unique
  company   User   @relation("CompanyIcpConfig", fields: [companyId], references: [id], onDelete: Cascade)

  /// LinkedIn-compatible location strings (e.g. "San Francisco, CA", "United Kingdom")
  locations    String[]

  /// LinkedIn company size codes: A-I (multi-select)
  companySizes String[]

  industries CompanyIcpIndustry[]

  @@index([companyId])
}

/// Individual industry selection within an ICP config.
/// Uses LinkedIn industry IDs (numeric strings) with human-readable labels.
model CompanyIcpIndustry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  configId String
  config   CompanyIcpConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  /// LinkedIn industry ID (numeric string, e.g. "96" for IT Services)
  industryId String

  /// Human-readable industry label (e.g. "IT Services and IT Consulting")
  label String

  @@unique([configId, industryId])
  @@index([configId])
}

// ────────────────────────────────────────────────────────────────────
// Signal Category Configuration
// ────────────────────────────────────────────────────────────────────

enum SignalCategory {
  HIRING
  FUNDING
  COMMUNITY
}

/// Per-service-catalog signal category configuration.
/// Each category maps to one or more internal signal providers (hidden from the company).
/// The company describes what it expects from each signal type **per service catalog**
/// so the AI can evaluate collected signals against those expectations during final scoring.
model SignalCategoryConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceCatalogId String
  serviceCatalog   CompanyServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Cascade)

  category    SignalCategory
  description String  @db.VarChar(500)
  enabled     Boolean @default(true)

  @@unique([serviceCatalogId, category])
  @@index([serviceCatalogId])
}
